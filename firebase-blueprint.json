{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Relationship contact for gift and condolence exchange",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "relation": { "type": "string" },
        "category": { "type": "string" },
        "phone": { "type": "string" },
        "exchangeCount": { "type": "number" },
        "totalSent": { "type": "number" },
        "totalReceived": { "type": "number" },
        "netBalance": { "type": "number" },
        "status": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "relation", "category"]
    },
    "RecordItem": {
      "title": "Record Item",
      "description": "Individual gift or condolence transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["sent", "received"] },
        "eventType": { "type": "string" },
        "category": { "type": "string" },
        "contactName": { "type": "string" },
        "contactId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "location": { "type": "string" },
        "memo": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "type", "eventType", "amount", "date", "contactName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User private profile document"
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": "Contact",
      "description": "Contacts managed by this user"
    },
    "/users/{userId}/records/{recordId}": {
      "schema": "RecordItem",
      "description": "Gifts and congratulatory records recorded by this user"
    }
  }
}
